# Local WordPress settings. Copy to .env (ignored by git) and change the passwords.
# Production does NOT use this file: it sets the same names in its own environment / wp-config.php.

# --- Database (local containers only) ---
DB_NAME=ndm_cms
DB_USER=ndm_cms
DB_PASSWORD=change-me-local-only
DB_ROOT_PASSWORD=change-me-local-only
DB_TABLE_PREFIX=ndm_

# --- WordPress ---
CMS_PORT=8080
# Address of WordPress itself.
# PRODUCTION PLACEHOLDER (not decided yet): https://<cms-host>
NDM_CMS_URL=http://localhost:8080
# local | development | staging | production
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=0

# --- The Next.js frontend ---
# Where visitors are sent when they open a WordPress address that is not the admin or the API.
# PRODUCTION PLACEHOLDER (not decided yet): https://<site-host>
NDM_FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call the REST API (CORS), comma separated, exact scheme://host[:port].
# Never "*". PRODUCTION PLACEHOLDER (not decided yet): https://<site-host>
NDM_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100

# --- First install only (bin/setup.sh) ---
WP_ADMIN_USER=change-me
WP_ADMIN_PASSWORD=change-me-local-only
WP_ADMIN_EMAIL=admin@example.test
WP_SITE_TITLE="NewDermaMed CMS"
