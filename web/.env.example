# Copy to .env.local (ignored by git). Server-side only: none of these names starts with NEXT_PUBLIC_,
# so none of them ever reaches the browser.

# REST API root of the headless WordPress (see ../cms). Leave empty to run the site without WordPress.
# Local: http://localhost:8080/wp-json
# PRODUCTION PLACEHOLDER (not decided yet): https://<cms-host>/wp-json   (https is required outside localhost)
WORDPRESS_API_URL=http://localhost:8080/wp-json

# The website's own WordPress account (ndm-site, made by ../cms/bin/setup.sh) and one of its application
# passwords. Needed to place order requests in WooCommerce; it can do nothing else. Public content is
# read without credentials. Never commit real values.
WORDPRESS_AUTH_USER=
WORDPRESS_AUTH_APP_PASSWORD=

# Optional. How long one WordPress request may take, in milliseconds (default 8000).
WORDPRESS_TIMEOUT_MS=

# --- Pricing page (WooCommerce) ---
# Shared secret WordPress sends to /api/revalidate after a price-list change made in wp-admin.
# The same value as NDM_REVALIDATE_SECRET in ../cms/.env. At least 32 characters. The site search
# also signs its "count this search" call to WordPress with it (the Popular chips).
REVALIDATE_SECRET=

# Encrypts the sign-in cookie of the price list's management screen (/manage/pricing). At least 32
# random characters (for example: openssl rand -hex 32). Changing it signs everyone out.
PRICING_ADMIN_SECRET=

# Public address of this site, used for the sign-in round trip to WordPress. Required in production
# (https); when empty in development the address of the request is used.
# PRODUCTION PLACEHOLDER (not decided yet): https://<site-host>
SITE_URL=

# Optional. Address of WordPress as a browser reaches it, when it differs from WORDPRESS_API_URL's host.
WORDPRESS_PUBLIC_URL=

# Existing: pass pages that are not migrated yet through to the static prototype.
# LEGACY_ORIGIN=http://localhost:5174
